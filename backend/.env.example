# KELET Backend Environment Configuration
# Copy this file to .env and configure your API keys

# Google Gemini API Key (required for AI-powered research)
GEMINI_API_KEY=

# Optional: Tavily Search API Key (improves source discovery)
TAVILY_API_KEY=

# Optional: SerpAPI Key
SERPAPI_API_KEY=

# Research Defaults
DEFAULT_DEPTH_MODE=comprehensive
DEFAULT_MODEL=gemini-1.5-flash
